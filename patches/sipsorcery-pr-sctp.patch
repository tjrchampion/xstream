+        /// <summary>
+        /// Handles a FORWARD TSN chunk (RFC3758 3.6): the sender abandoned every TSN up to
+        /// <see cref="SctpForwardTsnChunk.NewCumulativeTSN"/>, so stop waiting for them. Without this a
+        /// single abandoned chunk would hold the cumulative TSN back forever and the receive window
+        /// check would eventually reject all new data on every channel.
+        /// </summary>
+        /// <returns>Ordered-stream frames that became deliverable because skipped messages no longer block them.</returns>
+        public List<SctpDataFrame> OnForwardTsn(SctpForwardTsnChunk fwd)
+        {
+            var released = new List<SctpDataFrame>();
+            uint newCum = fwd.NewCumulativeTSN;
+
+            unchecked
+            {
+                if (_inOrderReceiveCount == 0)
+                {
+                    if (!IsNewerOrEqual(_initialTSN, newCum))
+                    {
+                        return released; // older than anything we expect
+                    }
+                    _lastInOrderTSN = newCum;
+                    _inOrderReceiveCount = 1;
+                }
+                else if (IsNewer(_lastInOrderTSN, newCum))
+                {
+                    _lastInOrderTSN = newCum;
+                }
+                else
+                {
+                    return released; // duplicate or stale FORWARD TSN
+                }
+
+                foreach (var tsn in _forwardTSN.Keys.Where(t => !IsNewer(newCum, t)).ToList())
+                {
+                    _forwardTSN.Remove(tsn);
+                }
+                foreach (var tsn in _fragmentedChunks.Keys.Where(t => !IsNewer(newCum, t)).ToList())
+                {
+                    _fragmentedChunks.Remove(tsn);
+                }
+                while (_forwardTSN.ContainsKey(_lastInOrderTSN + 1))
+                {
+                    _lastInOrderTSN++;
+                    _inOrderReceiveCount++;
+                    _forwardTSN.Remove(_lastInOrderTSN);
+                }
+
+                // Ordered streams: treat skipped stream sequence numbers as delivered, then release
+                // anything that was queued behind them.
+                foreach (var (streamID, ssn) in fwd.Streams)
+                {
+                    if (!_streamLatestSeqNums.TryGetValue(streamID, out var latest) || (short)(ssn - latest) > 0)
+                    {
+                        _streamLatestSeqNums[streamID] = ssn;
+                    }
+                    if (_streamOutOfOrderFrames.TryGetValue(streamID, out var queued))
+                    {
+                        foreach (var old in queued.Keys.Where(k => (short)(k - _streamLatestSeqNums[streamID]) <= 0).ToList())
+                        {
+                            queued.Remove(old);
+                        }
+                        ushort next = (ushort)(_streamLatestSeqNums[streamID] + 1);
+                        while (queued.TryGetValue(next, out var frame))
+                        {
+                            released.Add(frame);
+                            queued.Remove(next);
+                            _streamLatestSeqNums[streamID] = next;
+                            next++;
+                        }
+                    }
+                }
+            }
+
+            return released;
+        }
