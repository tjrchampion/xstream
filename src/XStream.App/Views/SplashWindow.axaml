<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="XStream.App.Views.SplashWindow"
        Title="Vexel"
        Icon="avares://XStream/Assets/xstream.png"
        Width="480" Height="300" CanResize="False"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None" Background="Transparent" TransparencyLevelHint="Transparent"
        ExtendClientAreaToDecorationsHint="True">
  <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" Padding="32,28">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="14">
        <Image Source="avares://XStream/Assets/xstream.png" Width="52" Height="52" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Vexel" FontSize="22" FontWeight="Bold" />
          <TextBlock Text="Xbox remote play" Classes="caption" />
        </StackPanel>
      </StackPanel>

      <StackPanel DockPanel.Dock="Bottom" Spacing="10" Name="Working">
        <TextBlock Name="Headline" Text="Setting up for first launch" FontSize="15" FontWeight="SemiBold" />
        <ProgressBar Name="Bar" Minimum="0" Maximum="100" Height="6" MinHeight="6" CornerRadius="3"
                     Foreground="{StaticResource Accent}" Background="{StaticResource Surface3}" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Name="Detail" Classes="caption" Text="Preparing…" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="1" Name="Percent" Classes="caption mono" Text="0%" />
        </Grid>
        <TextBlock Classes="caption faint" TextWrapping="Wrap" Text="This only happens once per version. Next time Vexel opens straight away." />
      </StackPanel>

      <StackPanel DockPanel.Dock="Bottom" Spacing="12" Name="Failed" IsVisible="False">
        <TextBlock Text="Vexel couldn't finish setting up" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Bad}" />
        <TextBlock Name="ErrorText" Classes="caption" TextWrapping="Wrap" />
        <Button Classes="ghost" Content="Close" HorizontalAlignment="Right" Click="OnClose" />
      </StackPanel>

      <Panel />
    </DockPanel>
  </Border>
</Window>
