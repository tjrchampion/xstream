<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XStream.App.ViewModels"
             x:Class="XStream.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <UserControl.Styles>
    <Style Selector="ToggleSwitch">
      <Setter Property="OnContent" Value="" /><Setter Property="OffContent" Value="" />
      <Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <!-- Section tabs -->
    <Style Selector="Border.tabs">
      <Setter Property="Background" Value="{StaticResource Surface2}" /><Setter Property="CornerRadius" Value="14" /><Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="Button.tab">
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16,10" /><Setter Property="Foreground" Value="{StaticResource Muted}" /><Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.tab PathIcon"><Setter Property="Width" Value="14" /><Setter Property="Height" Value="14" /></Style>
    <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#14FFFFFF" /><Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style Selector="Button.tab.on /template/ ContentPresenter#PART_ContentPresenter, Button.tab.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoft}" /><Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="36,32,36,36" Spacing="22" MaxWidth="960">
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="Settings" />
        <TextBlock Classes="muted" Text="Changes are saved straight away. Profile, bitrate, picture, sound and rumble also change a running stream." />
      </StackPanel>

      <!-- Sections: one at a time instead of one long page -->
      <Border Classes="tabs" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Classes="tab" Classes.on="{Binding IsStream}" Command="{Binding ShowSectionCommand}" CommandParameter="Stream">
            <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource Icon.Bolt}" /><TextBlock Text="Stream" /></StackPanel>
          </Button>
          <Button Classes="tab" Classes.on="{Binding IsSound}" Command="{Binding ShowSectionCommand}" CommandParameter="Sound">
            <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource Icon.Gamepad}" /><TextBlock Text="Sound and controls" /></StackPanel>
          </Button>
          <Button Classes="tab" Classes.on="{Binding IsLauncher}" Command="{Binding ShowSectionCommand}" CommandParameter="Launcher">
            <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource Icon.Console}" /><TextBlock Text="Launcher" /></StackPanel>
          </Button>
          <Button Classes="tab" Classes.on="{Binding IsSystem}" Command="{Binding ShowSectionCommand}" CommandParameter="System">
            <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource Icon.Settings}" /><TextBlock Text="System and account" /></StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <StackPanel Spacing="22" IsVisible="{Binding IsStream}">
      <!-- Profile -->
      <Border Classes="card">
        <StackPanel Spacing="16">
          <StackPanel Spacing="3">
            <TextBlock Classes="h2" Text="Stream profile" />
            <TextBlock Classes="caption" Text="How Vexel trades latency for a steady picture when the network gets rough." />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Profiles}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Rows="1" ColumnSpacing="12" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ProfileOption">
                <RadioButton Classes="profile" GroupName="profile" IsChecked="{Binding IsSelected}">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="h3" Text="{Binding Title}" />
                      <PathIcon Grid.Column="1" Data="{StaticResource Icon.Check}" Width="15" Height="15"
                                Foreground="{StaticResource Accent}" IsVisible="{Binding IsSelected}" />
                    </Grid>
                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Text="{Binding Blurb}" />
                    <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Detail}" />
                  </StackPanel>
                </RadioButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Quality -->
      <Border Classes="card">
        <StackPanel Spacing="16">
          <StackPanel Spacing="3">
            <TextBlock Classes="h2" Text="Quality" />
            <TextBlock Classes="caption" TextWrapping="Wrap" Text="What the console sends. Applies from the next stream." />
          </StackPanel>
          <UniformGrid Rows="1" ColumnSpacing="12">
            <RadioButton Classes="profile" GroupName="quality" IsChecked="{Binding QualitySharpest}">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="h3" Text="Sharpest" />
                  <PathIcon Grid.Column="1" Data="{StaticResource Icon.Check}" Width="15" Height="15" Foreground="{StaticResource Accent}" IsVisible="{Binding QualitySharpest}" />
                </Grid>
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Text="1440p, 4K where offered" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="The console's top tier: the most detail. Needs a strong network and a maximum bitrate of 30 Mbps or more." />
              </StackPanel>
            </RadioButton>
            <RadioButton Classes="profile" GroupName="quality" IsChecked="{Binding QualityFastest}">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="h3" Text="Fastest" />
                  <PathIcon Grid.Column="1" Data="{StaticResource Icon.Check}" Width="15" Height="15" Foreground="{StaticResource Accent}" IsVisible="{Binding QualityFastest}" />
                </Grid>
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Text="720p, about 10 ms quicker" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="Quicker from button to picture and far less data, for busy Wi-Fi and handhelds. Enhance keeps it crisp on a bigger screen." />
              </StackPanel>
            </RadioButton>
          </UniformGrid>
        </StackPanel>
      </Border>

      <!-- Bitrate -->
      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Classes="h2" Text="Bitrate" />
          <Grid Classes="row" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Maximum" />
              <TextBlock Classes="caption" Text="The console never sends more than this. Higher is sharper if your network keeps up." />
            </StackPanel>
            <TextBlock Grid.Column="1" Classes="mono" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Text="{Binding MaxMbpsText}" VerticalAlignment="Center" />
            <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="5" Maximum="60" SmallChange="1" LargeChange="5"
                    TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MaxMbps}" />
          </Grid>
          <Separator />
          <Grid Classes="row" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Starting bitrate" />
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="Where the stream starts before anything is measured; it then climbs toward the maximum. If a session report says the console ignores bitrate caps, lower the maximum instead." />
            </StackPanel>
            <TextBlock Grid.Column="1" Classes="mono" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Text="{Binding StartMbpsText}" VerticalAlignment="Center" Margin="16,0,0,0" />
            <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="2" Maximum="60" SmallChange="1" LargeChange="5"
                    TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding StartMbps}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Video -->
      <Border Classes="card">
        <StackPanel>
          <TextBlock Classes="h2" Text="Video" Margin="0,0,0,6" />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Connection alerts" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="A short message over the game when the connection or frame rate suffers, when it recovers, and when the battery runs low." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ConnectionAlerts}" />
          </Grid>
          <Separator />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Achievement alerts" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="Shows achievements you unlock while streaming, with their gamerscore (checked about every 30 seconds)." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AchievementAlerts}" />
          </Grid>
          <Separator />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Achievement clips" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="Saves a 25-second clip of the moment you unlock an achievement to your Videos › Vexel folder. Keeps the last minute in memory while you stream a console." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AchievementClips}" />
          </Grid>
          <Separator />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Enhance" />
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="When the stream is smaller than your screen (720p on a 1080p display, 1440p on 4K), enlarge it edge-aware, in the style of AMD FSR 1, so text and edges stay sharp instead of soft. Costs well under a millisecond." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Enhance}" />
          </Grid>
          <Separator />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Clarity boost" />
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="Sharpens edges before the picture is scaled up to your screen, without halos (about 1 ms per frame). Change it live from the stream menu to compare." />
            </StackPanel>
            <ItemsControl Grid.Column="1" ItemsSource="{Binding ClarityOptions}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ClarityOption">
                  <RadioButton Classes="profile seg" GroupName="clarity" IsChecked="{Binding IsSelected}">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                  </RadioButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
          <Separator />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Full screen" />
              <TextBlock Classes="caption" Text="Borderless full screen, and the lowest delay: on a Mac a window adds about 15 ms before each frame reaches the display. Also what AMD Fluid Motion Frames needs on the ROG Ally X." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Fullscreen}" />
          </Grid>
          <Separator />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="GPU video decoding" />
              <TextBlock Classes="caption" Text="D3D11VA on Windows, VideoToolbox on Mac. Turn off only to troubleshoot." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding HardwareDecode}" />
          </Grid>
          <Separator />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Picture" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="The console always sends 16:9. On a 16:10 screen (MacBooks) Fit shows bars; Fill covers the screen by trimming the sides (about 5-7% each); Stretch covers it with everything visible, but 11-15% taller. Switch live from the stream menu." />
            </StackPanel>
            <ComboBox Grid.Column="1" MinWidth="250" VerticalAlignment="Center" ItemsSource="{Binding ScalingModes}" SelectedIndex="{Binding ScalingIndex}" />
          </Grid>
          <Separator />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Colour filter" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="For colour blindness: shifts colours that look alike to you apart, so red and green (or blue and yellow) markers, maps and teams are easier to tell apart. Switch live from the stream menu." />
            </StackPanel>
            <ComboBox Grid.Column="1" MinWidth="250" VerticalAlignment="Center" ItemsSource="{Binding ColorFilterModes}" SelectedIndex="{Binding ColorFilterIndex}" />
          </Grid>
          <Grid Classes="row" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" IsEnabled="{Binding ColorFilterOn}">
            <TextBlock FontWeight="SemiBold" Text="Filter strength" />
            <TextBlock Grid.Column="1" Classes="mono" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Text="{Binding ColorFilterStrengthText}" />
            <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding ColorFilterStrength}" />
          </Grid>
          <Separator />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="V-Sync" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="Off shows each frame the moment it's decoded (tear-free on VRR screens). On removes tearing elsewhere, at up to one refresh of extra lag." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding VSync}" />
          </Grid>
        </StackPanel>
      </Border>

      </StackPanel>

      <StackPanel Spacing="22" IsVisible="{Binding IsSound}">
      <!-- Audio and controller -->
      <Border Classes="card">
        <StackPanel>
          <TextBlock Classes="h2" Text="Sound and controller" Margin="0,0,0,6" />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Game audio" />
              <TextBlock Classes="caption" Text="Kept about 40 ms behind (30 on Competitive, 80 on Smooth) so it stays in sync. Mute it from the stream menu." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Audio}" />
          </Grid>
          <Grid Classes="row" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" IsEnabled="{Binding Audio}">
            <TextBlock FontWeight="SemiBold" Text="Volume" />
            <TextBlock Grid.Column="1" Classes="mono" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Text="{Binding VolumeText}" />
            <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Volume}" />
          </Grid>
          <Separator />
          <Grid Classes="row" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Rumble strength" />
              <TextBlock Classes="caption" Text="Controller vibration from the game." />
            </StackPanel>
            <TextBlock Grid.Column="1" Classes="mono" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Text="{Binding RumbleText}" VerticalAlignment="Center" />
            <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100" SmallChange="10" LargeChange="25" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding RumbleStrength}" />
          </Grid>
          <Separator />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Trigger rumble" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="Impulse-trigger vibration. Off matches the Xbox web player; racing games buzz the triggers constantly on the throttle." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding TriggerRumble}" />
          </Grid>
          <Separator />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Microphone (party and game chat)" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="Sends this device's microphone to the console, for Xbox party chat and for Discord voice moved to the Xbox (Discord app: join a voice channel, then Transfer to Xbox). F9 mutes it during a stream; the stream menu mutes it while open." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Microphone}" />
          </Grid>
          <StackPanel Spacing="0" IsVisible="{Binding Microphone}">
            <Separator />
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Which microphone" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="Pick your headset rather than the built-in mic for less echo. Test it to see the level move as you talk." />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ComboBox MinWidth="240" ItemsSource="{Binding MicDevices}" SelectedItem="{Binding MicDevice}" />
                <Button Classes="ghost" Command="{Binding TestMicCommand}">
                  <Panel>
                    <TextBlock Text="Test" IsVisible="{Binding !MicTesting}" />
                    <TextBlock Text="Stop" IsVisible="{Binding MicTesting}" />
                  </Panel>
                </Button>
              </StackPanel>
            </Grid>
            <StackPanel Spacing="4" IsVisible="{Binding MicTesting}" Margin="0,0,0,10">
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding MicLevel}" Height="6" MinHeight="6" HorizontalAlignment="Stretch" />
              <TextBlock Classes="caption" Text="{Binding MicTestText}" />
            </StackPanel>
            <Separator />
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Push to talk" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="Only send while F9 or the microphone button is held. Off: an open mic that F9 or the button mutes and unmutes." />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding PushToTalk}" />
            </Grid>
            <Separator />
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Microphone button" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="A controller button for the mic (it's kept from the game). Back paddles on an Elite or DualSense Edge suit it best." />
              </StackPanel>
              <ComboBox Grid.Column="1" MinWidth="220" VerticalAlignment="Center" ItemsSource="{Binding MicButtons}" SelectedIndex="{Binding MicButtonIndex}" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Controller layouts live on the Mapping page; instant replay stays here -->
      <Border Classes="card">
        <StackPanel>
          <TextBlock Classes="h2" Text="Controls and clips" Margin="0,0,0,6" />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Button layouts and gyro" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="Remap buttons and set up gyro aiming for all games or one game at a time, on the Mapping page." />
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Center" Command="{Binding OpenMappingCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Gamepad}" Width="14" Height="14" />
                <TextBlock Text="Open Mapping" />
              </StackPanel>
            </Button>
          </Grid>
          <Separator />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Instant replay" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="Keeps the last 30 seconds so you can save a clip: F10, or Save last 30 seconds in the stream menu. Clips go to Videos › Vexel. Uses about 200 MB of memory, and the console sends a fresh keyframe every 10 seconds." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding InstantReplay}" />
          </Grid>
        </StackPanel>
      </Border>

      </StackPanel>

      <StackPanel Spacing="22" IsVisible="{Binding IsLauncher}">
      <!-- Launcher -->
      <Border Classes="card">
        <StackPanel>
          <TextBlock Classes="h2" Text="Launcher" Margin="0,0,0,6" />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Open full screen" />
              <TextBlock Classes="caption" Text="Best on the ROG Ally and other handhelds. F11 switches at any time." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding LauncherFullscreen}" />
          </Grid>
          <Separator />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Connect on launch" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="Go straight into your last console when Vexel opens. Press B on the connecting screen to stay in the launcher." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoConnect}" />
          </Grid>
          <Separator />
          <Grid Classes="row" RowDefinitions="Auto,Auto,Auto">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Shortcuts (Steam, Armoury Crate, Playnite)" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="Add Vexel as a game in your launcher with these launch options to go straight into a stream. --stream uses your last console; --stream &quot;Name&quot; picks one; --game PRODUCTID starts a game on it first; --cloud TITLEID plays a cloud game." />
            </StackPanel>
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
              <TextBox Classes="mono" IsReadOnly="True" Text="{Binding ShortcutTarget, Mode=OneWay}" />
              <Button Grid.Column="1" Classes="ghost" Margin="8,0,0,0" Content="Copy" Click="CopyTarget" />
            </Grid>
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,6,0,0">
              <TextBox Classes="mono" IsReadOnly="True" Text="{Binding ShortcutOptions, Mode=OneWay}" />
              <Button Grid.Column="1" Classes="ghost" Margin="8,0,0,0" Content="Copy" Click="CopyOptions" />
            </Grid>
          </Grid>
          <Separator IsVisible="{Binding IsWindows}" />
          <Grid Classes="row" ColumnDefinitions="*,Auto" IsVisible="{Binding IsWindows}">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Run the display at 60 Hz while streaming" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="The console sends 60 frames a second. On a 120 Hz screen (ROG Ally) this paces frames evenly and saves battery. Switches back afterwards." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding MatchRefreshRate}" />
          </Grid>
          <Separator />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Show on Discord" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="&quot;Playing Forza Horizon 5 via Vexel&quot; on your Discord profile while you stream (when Discord is running)." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding DiscordStatus}" />
          </Grid>
          <Separator />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Hide while streaming" />
              <TextBlock Classes="caption" Text="Minimise this window once a full-screen stream starts; it comes back when the stream ends." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding HideLauncherWhileStreaming}" />
          </Grid>
          <Separator />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Controller navigation" />
              <TextBlock Classes="caption" Text="Move around with the D-pad or stick, A to select, B to go back, LB/RB to switch pages." />
              <TextBlock Classes="caption faint" Text="{Binding ControllerStatus}" Margin="0,2,0,0" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ControllerNavigation}" />
          </Grid>
        </StackPanel>
      </Border>

      </StackPanel>

      <StackPanel Spacing="22" IsVisible="{Binding IsSystem}">
      <!-- System check -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
              <TextBlock Classes="h2" Text="System check" />
              <TextBlock Classes="caption" Text="What the stream needs on this device." />
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" Command="{Binding RunChecksCommand}" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Refresh}" />
                <TextBlock Text="Check again" />
              </StackPanel>
            </Button>
          </Grid>
          <ItemsControl ItemsSource="{Binding Checks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CheckItem">
                <Border Classes="tile" Margin="0,0,0,8">
                  <Grid ColumnDefinitions="Auto,*">
                    <Border Width="24" Height="24" CornerRadius="12" VerticalAlignment="Top" Margin="0,1,12,0"
                            Background="{StaticResource AccentSoft}" IsVisible="{Binding Ok}">
                      <PathIcon Data="{StaticResource Icon.Check}" Width="12" Height="12" Foreground="{StaticResource Accent}" />
                    </Border>
                    <Border Width="24" Height="24" CornerRadius="12" VerticalAlignment="Top" Margin="0,1,12,0"
                            Background="{StaticResource WarnSoft}" IsVisible="{Binding !Ok}">
                      <PathIcon Data="{StaticResource Icon.Alert}" Width="12" Height="12" Foreground="{StaticResource Warn}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                      <TextBlock Classes="caption" Text="{Binding Detail}" TextWrapping="Wrap" />
                      <SelectableTextBlock Classes="mono" FontSize="12" Foreground="{StaticResource Warn}" Text="{Binding Fix}"
                                           IsVisible="{Binding HasFix}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Updates -->
      <Border Classes="card">
        <StackPanel>
          <TextBlock Classes="h2" Text="Updates" Margin="0,0,0,6" />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="{Binding VersionText}" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="New versions download in the background. Install one with the button, or it installs the next time you open Vexel. Every update is checked against Vexel's signature first." />
              <TextBlock Classes="caption" Foreground="{StaticResource Accent}" Text="{Binding UpdateStatus}" TextWrapping="Wrap" Margin="0,4,0,0"
                         IsVisible="{Binding UpdateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Button Classes="primary" Content="Install and restart" Command="{Binding InstallUpdateCommand}" IsVisible="{Binding CanInstallUpdate}"
                      IsEnabled="{Binding !Stream.IsRunning}" ToolTip.Tip="Closes Vexel, installs the new version and opens it again (a few seconds)" />
              <Button Classes="primary" Content="Download" Command="{Binding OpenReleasesPageCommand}" IsVisible="{Binding UpdateAvailableElsewhere}" />
              <Button Classes="ghost" Command="{Binding CheckForUpdatesCommand}" IsVisible="{Binding !CanInstallUpdate}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource Icon.Refresh}" />
                  <TextBlock Text="Check now" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
          <Separator />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Update automatically" />
              <TextBlock Classes="caption" Text="Check when Vexel opens and every few hours." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoUpdate}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Data -->
      <Border Classes="card">
        <StackPanel Spacing="14">
          <StackPanel Spacing="3">
            <TextBlock Classes="h2" Text="Data and account" />
            <TextBlock Classes="caption">
              <Run Text="Sign-in, settings and session logs are kept in " /><Run Text="{Binding DataFolder}" FontFamily="Menlo, Consolas, monospace" />
            </TextBlock>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="ghost" Command="{Binding OpenDataFolderCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Folder}" />
                <TextBlock Text="Open folder" />
              </StackPanel>
            </Button>
            <Button Classes="ghost" Command="{Binding ExportDiagnosticsCommand}" ToolTip.Tip="Zip of recent session logs, crash reports and device info (no sign-in details)">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Bug}" />
                <TextBlock Text="Export diagnostics" />
              </StackPanel>
            </Button>
            <Button Classes="ghost" Content="Reset settings" Command="{Binding ResetDefaultsCommand}" />
            <Button Classes="danger" Command="{Binding SignOutCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Logout}" />
                <TextBlock Text="Sign out" />
              </StackPanel>
            </Button>
          </StackPanel>
          <TextBlock Classes="caption" Text="{Binding DiagnosticsStatus}" TextWrapping="Wrap"
                     IsVisible="{Binding DiagnosticsStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
