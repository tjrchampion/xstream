<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XStream.App.ViewModels"
             x:Class="XStream.App.Views.MappingView"
             x:DataType="vm:MappingViewModel">
  <UserControl.Resources>
    <!-- One button on the controller drawing: its face, its name, and a tag saying what it now does -->
    <DataTemplate x:Key="SlotFace" x:DataType="vm:ButtonSlotViewModel">
      <Panel>
        <Border Classes="face"><TextBlock Classes="face" Text="{Binding Label}" /></Border>
        <Border Classes="badge" IsVisible="{Binding IsRemapped}" Classes.off="{Binding IsOff}">
          <TextBlock Text="{Binding Badge}" />
        </Border>
      </Panel>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Game tiles -->
    <Style Selector="Button.game">
      <Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="14" /><Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.game /template/ ContentPresenter#PART_ContentPresenter, Button.game:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.game:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.game:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.game Border.ring">
      <Setter Property="CornerRadius" Value="14" /><Setter Property="BorderThickness" Value="3" /><Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Button.game:pointerover Border.ring, Button.game:focus Border.ring"><Setter Property="BorderBrush" Value="#803DDC97" /></Style>
    <Style Selector="Button.game.selected Border.ring"><Setter Property="BorderBrush" Value="{StaticResource Accent}" /></Style>

    <!-- Controller buttons -->
    <Style Selector="Button.slot">
      <Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="FocusAdorner" Value="{x:Null}" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="ContentTemplate" Value="{StaticResource SlotFace}" />
    </Style>
    <Style Selector="Button.slot /template/ ContentPresenter#PART_ContentPresenter, Button.slot:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.slot:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.slot:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="ClipToBounds" Value="False" /><Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.slot"><Setter Property="ClipToBounds" Value="False" /></Style>
    <Style Selector="Button.slot Border.face">
      <Setter Property="CornerRadius" Value="99" /><Setter Property="Background" Value="#2A313B" />
      <Setter Property="BorderBrush" Value="#3A434F" /><Setter Property="BorderThickness" Value="2" />
      <Setter Property="Transitions"><Transitions><BrushTransition Property="BorderBrush" Duration="0:0:0.12" /></Transitions></Setter>
    </Style>
    <Style Selector="Button.slot TextBlock.face">
      <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontWeight" Value="Bold" /><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style Selector="Button.slot.a Border.face"><Setter Property="Background" Value="#3E7A2E" /><Setter Property="BorderBrush" Value="#6CC24A" /></Style>
    <Style Selector="Button.slot.b Border.face"><Setter Property="Background" Value="#8A2A2D" /><Setter Property="BorderBrush" Value="#E5484D" /></Style>
    <Style Selector="Button.slot.x Border.face"><Setter Property="Background" Value="#1F4F94" /><Setter Property="BorderBrush" Value="#3D8BFD" /></Style>
    <Style Selector="Button.slot.y Border.face"><Setter Property="Background" Value="#8C6A1E" /><Setter Property="BorderBrush" Value="#F5B841" /></Style>
    <Style Selector="Button.slot.square Border.face"><Setter Property="CornerRadius" Value="8" /></Style>
    <Style Selector="Button.slot.bumper Border.face"><Setter Property="CornerRadius" Value="12,12,6,6" /></Style>
    <Style Selector="Button.slot.small TextBlock.face"><Setter Property="FontSize" Value="11" /></Style>
    <Style Selector="Button.slot:pointerover Border.face, Button.slot:focus Border.face"><Setter Property="BorderBrush" Value="{StaticResource Accent}" /></Style>
    <Style Selector="Button.slot.selected Border.face">
      <Setter Property="BorderBrush" Value="White" /><Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="Button.slot Border.badge">
      <Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,-12,-16,0" /><Setter Property="Padding" Value="6,1" /><Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{StaticResource Accent}" /><Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Button.slot Border.badge > TextBlock"><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="Foreground" Value="#0C0E12" /></Style>
    <Style Selector="Button.slot Border.badge.off"><Setter Property="Background" Value="{StaticResource Muted}" /></Style>

    <!-- Choices in the side panel -->
    <Style Selector="Button.choice">
      <Setter Property="MinWidth" Value="64" /><Setter Property="Height" Value="40" /><Setter Property="CornerRadius" Value="10" />
      <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.choice.current">
      <Setter Property="Background" Value="{StaticResource AccentSoft}" /><Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="Button.preset"><Setter Property="CornerRadius" Value="18" /><Setter Property="Padding" Value="14,8" /></Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="36,32,36,36" Spacing="22" MaxWidth="1240">
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="Mapping" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Give each game its own controls. Vexel switches layouts by itself when the game changes, even mid-stream." />
      </StackPanel>

      <!-- Games: what's playing now, recent games, and the ones with their own layout -->
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Games}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MappingGameViewModel">
              <Button Classes="game" Classes.selected="{Binding IsSelected}" Width="208" Height="124" ClipToBounds="True"
                      Command="{Binding SelectCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding Name}">
                <Panel>
                  <Border CornerRadius="14" ClipToBounds="True">
                    <Panel>
                      <Border Background="{StaticResource Surface2}" />
                      <PathIcon Data="{StaticResource Icon.Gamepad}" Width="38" Height="38" Foreground="#55FFFFFF"
                                IsVisible="{Binding !HasArt}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,18" />
                      <Image Source="{Binding Art}" Stretch="UniformToFill" />
                      <Border>
                        <Border.Background>
                          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#00000000" Offset="0.35" /><GradientStop Color="#EE101318" Offset="1" />
                          </LinearGradientBrush>
                        </Border.Background>
                      </Border>
                    </Panel>
                  </Border>
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Border Classes="chip accent" Background="#E60C0E12" IsVisible="{Binding IsPlayingNow}">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse Classes="dot good pulse" VerticalAlignment="Center" />
                        <TextBlock Text="Playing now" />
                      </StackPanel>
                    </Border>
                    <Border Classes="chip accent" Background="#E60C0E12" IsVisible="{Binding HasLayout}"><TextBlock Text="Own layout" /></Border>
                    <Border Classes="chip" Background="#E60C0E12" IsVisible="{Binding IsCloud}"><TextBlock Text="Cloud" /></Border>
                  </StackPanel>
                  <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Bottom" Margin="12,0,12,10" />
                  <Border Classes="ring" />
                </Panel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Which layout this is -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="3">
          <TextBlock Classes="h2" Text="{Binding Title}" />
          <TextBlock Classes="muted" Text="{Binding Scope}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Classes="chip accent" VerticalAlignment="Center"><TextBlock Text="{Binding ChangedText}" /></Border>
          <Button Classes="ghost" Content="Use the default layout" Command="{Binding UseDefaultCommand}" IsVisible="{Binding CanUseDefault}" />
        </StackPanel>
      </Grid>

      <Grid ColumnDefinitions="*,20,380">
        <!-- The controller: click a button to change it -->
        <Border Classes="card" Padding="20,16">
          <StackPanel Spacing="12">
            <Viewbox Stretch="Uniform" MaxHeight="440">
              <Canvas Width="660" Height="430">
                <!-- Triggers (shown for orientation; they stay as they are) -->
                <Path Fill="#20262E" Data="M 150,62 C 160,30 215,22 240,36 L 246,64 C 220,56 180,58 150,74 Z" />
                <Path Fill="#20262E" Data="M 510,62 C 500,30 445,22 420,36 L 414,64 C 440,56 480,58 510,74 Z" />
                <TextBlock Canvas.Left="186" Canvas.Top="32" Text="LT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Faint}" />
                <TextBlock Canvas.Left="456" Canvas.Top="32" Text="RT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Faint}" />
                <!-- Body -->
                <Path Stroke="#3A434F" StrokeThickness="2"
                      Data="M 170,92 C 220,74 270,82 330,82 C 390,82 440,74 490,92 C 565,118 610,210 632,300 C 648,372 612,418 568,406 C 528,394 498,334 462,306 C 428,290 232,290 198,306 C 162,334 132,394 92,406 C 48,418 12,372 28,300 C 50,210 95,118 170,92 Z">
                  <Path.Fill>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                      <GradientStop Color="#232A33" Offset="0" /><GradientStop Color="#181D24" Offset="1" />
                    </LinearGradientBrush>
                  </Path.Fill>
                </Path>
                <!-- Stick wells and D-pad well -->
                <Ellipse Canvas.Left="150" Canvas.Top="128" Width="96" Height="96" Fill="#12161B" />
                <Ellipse Canvas.Left="372" Canvas.Top="212" Width="96" Height="96" Fill="#12161B" />
                <Ellipse Canvas.Left="202" Canvas.Top="206" Width="108" Height="108" Fill="#12161B" />
                <Ellipse Canvas.Left="408" Canvas.Top="104" Width="136" Height="136" Fill="#12161B" />

                <!-- Bumpers -->
                <Button Classes="slot bumper" Classes.selected="{Binding LB.IsSelected}" Classes.remapped="{Binding LB.IsRemapped}"
                        Canvas.Left="150" Canvas.Top="66" Width="92" Height="30" Content="{Binding LB}" Command="{Binding LB.PickCommand}" CommandParameter="{Binding LB}" />
                <Button Classes="slot bumper" Classes.selected="{Binding RB.IsSelected}" Classes.remapped="{Binding RB.IsRemapped}"
                        Canvas.Left="418" Canvas.Top="66" Width="92" Height="30" Content="{Binding RB}" Command="{Binding RB.PickCommand}" CommandParameter="{Binding RB}" />
                <!-- Sticks (press = LS / RS) -->
                <Button Classes="slot" Classes.selected="{Binding LS.IsSelected}" Classes.remapped="{Binding LS.IsRemapped}"
                        Canvas.Left="166" Canvas.Top="144" Width="64" Height="64" Content="{Binding LS}" Command="{Binding LS.PickCommand}" CommandParameter="{Binding LS}" />
                <Button Classes="slot" Classes.selected="{Binding RS.IsSelected}" Classes.remapped="{Binding RS.IsRemapped}"
                        Canvas.Left="388" Canvas.Top="228" Width="64" Height="64" Content="{Binding RS}" Command="{Binding RS.PickCommand}" CommandParameter="{Binding RS}" />
                <!-- D-pad -->
                <Button Classes="slot square small" Classes.selected="{Binding Up.IsSelected}" Classes.remapped="{Binding Up.IsRemapped}"
                        Canvas.Left="236" Canvas.Top="212" Width="40" Height="34" Content="{Binding Up}" Command="{Binding Up.PickCommand}" CommandParameter="{Binding Up}" />
                <Button Classes="slot square small" Classes.selected="{Binding Down.IsSelected}" Classes.remapped="{Binding Down.IsRemapped}"
                        Canvas.Left="236" Canvas.Top="274" Width="40" Height="34" Content="{Binding Down}" Command="{Binding Down.PickCommand}" CommandParameter="{Binding Down}" />
                <Button Classes="slot square small" Classes.selected="{Binding Left.IsSelected}" Classes.remapped="{Binding Left.IsRemapped}"
                        Canvas.Left="204" Canvas.Top="243" Width="40" Height="34" Content="{Binding Left}" Command="{Binding Left.PickCommand}" CommandParameter="{Binding Left}" />
                <Button Classes="slot square small" Classes.selected="{Binding Right.IsSelected}" Classes.remapped="{Binding Right.IsRemapped}"
                        Canvas.Left="268" Canvas.Top="243" Width="40" Height="34" Content="{Binding Right}" Command="{Binding Right.PickCommand}" CommandParameter="{Binding Right}" />
                <!-- View, Xbox, Menu -->
                <Button Classes="slot small" Classes.selected="{Binding View.IsSelected}" Classes.remapped="{Binding View.IsRemapped}"
                        Canvas.Left="270" Canvas.Top="158" Width="44" Height="30" Content="{Binding View}" Command="{Binding View.PickCommand}" CommandParameter="{Binding View}" />
                <Button Classes="slot small" Classes.selected="{Binding Nexus.IsSelected}" Classes.remapped="{Binding Nexus.IsRemapped}"
                        Canvas.Left="304" Canvas.Top="100" Width="52" Height="52" Content="{Binding Nexus}" Command="{Binding Nexus.PickCommand}" CommandParameter="{Binding Nexus}" />
                <Button Classes="slot small" Classes.selected="{Binding Menu.IsSelected}" Classes.remapped="{Binding Menu.IsRemapped}"
                        Canvas.Left="346" Canvas.Top="158" Width="44" Height="30" Content="{Binding Menu}" Command="{Binding Menu.PickCommand}" CommandParameter="{Binding Menu}" />
                <!-- Face buttons -->
                <Button Classes="slot y" Classes.selected="{Binding Y.IsSelected}" Classes.remapped="{Binding Y.IsRemapped}"
                        Canvas.Left="456" Canvas.Top="112" Width="40" Height="40" Content="{Binding Y}" Command="{Binding Y.PickCommand}" CommandParameter="{Binding Y}" />
                <Button Classes="slot x" Classes.selected="{Binding X.IsSelected}" Classes.remapped="{Binding X.IsRemapped}"
                        Canvas.Left="416" Canvas.Top="152" Width="40" Height="40" Content="{Binding X}" Command="{Binding X.PickCommand}" CommandParameter="{Binding X}" />
                <Button Classes="slot b" Classes.selected="{Binding B.IsSelected}" Classes.remapped="{Binding B.IsRemapped}"
                        Canvas.Left="496" Canvas.Top="152" Width="40" Height="40" Content="{Binding B}" Command="{Binding B.PickCommand}" CommandParameter="{Binding B}" />
                <Button Classes="slot a" Classes.selected="{Binding A.IsSelected}" Classes.remapped="{Binding A.IsRemapped}"
                        Canvas.Left="456" Canvas.Top="192" Width="40" Height="40" Content="{Binding A}" Command="{Binding A.PickCommand}" CommandParameter="{Binding A}" />
              </Canvas>
            </Viewbox>

            <!-- Back paddles -->
            <Border Background="{StaticResource Surface2}" CornerRadius="12" Padding="14,10">
              <StackPanel Spacing="10">
                <StackPanel Spacing="1">
                  <TextBlock FontWeight="SemiBold" Text="Back paddles" />
                  <TextBlock Classes="caption" Text="The buttons on the back of Xbox Elite and DualSense Edge controllers" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="18" Margin="0,6,0,0">
                  <Button Classes="slot square" Classes.selected="{Binding P1.IsSelected}" Classes.remapped="{Binding P1.IsRemapped}"
                          Width="46" Height="34" Content="{Binding P1}" Command="{Binding P1.PickCommand}" CommandParameter="{Binding P1}" />
                  <Button Classes="slot square" Classes.selected="{Binding P2.IsSelected}" Classes.remapped="{Binding P2.IsRemapped}"
                          Width="46" Height="34" Content="{Binding P2}" Command="{Binding P2.PickCommand}" CommandParameter="{Binding P2}" />
                  <Button Classes="slot square" Classes.selected="{Binding P3.IsSelected}" Classes.remapped="{Binding P3.IsRemapped}"
                          Width="46" Height="34" Content="{Binding P3}" Command="{Binding P3.PickCommand}" CommandParameter="{Binding P3}" />
                  <Button Classes="slot square" Classes.selected="{Binding P4.IsSelected}" Classes.remapped="{Binding P4.IsRemapped}"
                          Width="46" Height="34" Content="{Binding P4}" Command="{Binding P4.PickCommand}" CommandParameter="{Binding P4}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Right: change the chosen button, quick layouts, gyro -->
        <StackPanel Grid.Column="2" Spacing="16">
          <Border Classes="card" Padding="20">
            <Panel>
              <StackPanel Spacing="10" IsVisible="{Binding !HasSlot}">
                <TextBlock Classes="h3" Text="Change a button" />
                <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13"
                           Text="Click (or select with the D-pad) any button on the controller, then choose what it should do. A green tag shows what a button has been changed to." />
              </StackPanel>
              <StackPanel Spacing="12" IsVisible="{Binding HasSlot}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="h3" Text="{Binding SlotTitle}" TextWrapping="Wrap" />
                    <TextBlock Classes="caption" Text="{Binding Slot.Describe}" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="ghost" Padding="8" Command="{Binding CloseSlotCommand}" VerticalAlignment="Top" ToolTip.Tip="Done">
                    <PathIcon Data="{StaticResource Icon.Close}" Width="12" Height="12" />
                  </Button>
                </Grid>
                <TextBlock Classes="label" Text="IT SHOULD ACT AS" />
                <ItemsControl ItemsSource="{Binding Choices}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="8" LineSpacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TargetChoice">
                      <Button Classes="ghost choice" Classes.current="{Binding IsCurrent}" Content="{Binding Label}" Command="{Binding Choose}" CommandParameter="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="ghost" HorizontalAlignment="Left" Command="{Binding ResetSlotCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource Icon.Refresh}" Width="13" Height="13" />
                    <TextBlock Text="Back to normal" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Panel>
          </Border>

          <Border Classes="card" Padding="20">
            <StackPanel Spacing="10">
              <TextBlock Classes="h3" Text="Quick layouts" />
              <ItemsControl ItemsSource="{Binding PresetNames}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="8" LineSpacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Button Classes="ghost preset" Content="{Binding}" FontSize="13"
                            Command="{Binding $parent[UserControl].((vm:MappingViewModel)DataContext).ApplyPresetCommand}" CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="card" Padding="20">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Classes="h3" Text="Gyro aiming" />
                  <TextBlock Classes="caption" TextWrapping="Wrap" Text="Tilt to aim: moves the right stick. DualSense, DualShock 4 or Switch Pro." />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding GyroAim}" OnContent="" OffContent="" VerticalAlignment="Top" />
              </Grid>
              <StackPanel Spacing="6" IsEnabled="{Binding GyroAim}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock FontSize="13" Text="Sensitivity" />
                  <TextBlock Grid.Column="1" Classes="mono" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Text="{Binding GyroText}" />
                </Grid>
                <Slider Minimum="0.25" Maximum="4" SmallChange="0.25" LargeChange="0.5" TickFrequency="0.25" IsSnapToTickEnabled="True" Value="{Binding GyroSensitivity}" />
                <TextBlock FontSize="13" Text="Gyro is on" Margin="0,4,0,0" />
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding GyroHoldNames}" SelectedIndex="{Binding GyroHoldIndex}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
