<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XStream.App.ViewModels"
             xmlns:c="using:XStream.App.Controls"
             x:Class="XStream.App.Views.ConnectingView"
             x:DataType="vm:StreamViewModel"
             Background="{StaticResource Bg}">
  <UserControl.Styles>
    <!-- The progress bar: thin track, accent fill with a soft glow, smooth movement -->
    <Style Selector="ProgressBar.loader">
      <Setter Property="Height" Value="6" /><Setter Property="MinHeight" Value="6" /><Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="#2EFFFFFF" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="Effect"><DropShadowEffect Color="#3DDC97" BlurRadius="14" OffsetX="0" OffsetY="0" Opacity="0.55" /></Setter>
    </Style>
    <Style Selector="ProgressBar.loader /template/ Border#PART_Indicator">
      <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="TextBlock.phase"><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="#73FFFFFF" />
      <Setter Property="Transitions"><Transitions><BrushTransition Property="Foreground" Duration="0:0:0.4" /></Transitions></Setter></Style>
    <Style Selector="TextBlock.phase.on"><Setter Property="Foreground" Value="#F2FFFFFF" /></Style>

    <!-- Slow-moving glow for when there's no game art yet -->
    <Style Selector="Ellipse.glow">
      <Style.Animations>
        <Animation Duration="0:0:9" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="-120" /><Setter Property="Opacity" Value="0.55" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="140" /><Setter Property="Opacity" Value="0.9" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>

  <Panel>
    <!-- Fallback backdrop -->
    <Panel IsVisible="{Binding !#Slides.HasArt}">
      <Ellipse Classes="glow" Width="1100" Height="900" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-200,-300,0,0">
        <Ellipse.Fill>
          <RadialGradientBrush><GradientStop Color="#593DDC97" Offset="0" /><GradientStop Color="#003DDC97" Offset="1" /></RadialGradientBrush>
        </Ellipse.Fill>
        <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse Classes="glow" Width="1000" Height="900" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-250,-350">
        <Ellipse.Fill>
          <RadialGradientBrush><GradientStop Color="#4D1E9E8F" Offset="0" /><GradientStop Color="#001E9E8F" Offset="1" /></RadialGradientBrush>
        </Ellipse.Fill>
        <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
      </Ellipse>
    </Panel>

    <!-- Game art -->
    <c:ArtSlideshow x:Name="Slides" Items="{Binding Art}" IsActive="{Binding ShowStartScreen}" />

    <!-- Shading so the text reads on any picture -->
    <Border IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Color="#990C0E12" Offset="0" />
          <GradientStop Color="#000C0E12" Offset="0.28" />
          <GradientStop Color="#400C0E12" Offset="0.45" />
          <GradientStop Color="#D90C0E12" Offset="0.72" />
          <GradientStop Color="#F70C0E12" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <Border IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
          <GradientStop Color="#B30C0E12" Offset="0" />
          <GradientStop Color="#000C0E12" Offset="0.6" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <Grid RowDefinitions="Auto,*,Auto" Margin="56,44,56,48">
      <!-- Top bar -->
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="11">
          <Image Source="avares://XStream/Assets/xstream.png" Width="34" Height="34" RenderOptions.BitmapInterpolationMode="HighQuality" />
          <TextBlock Text="Vexel" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>
        <Border Grid.Column="2" Classes="chip" Background="#40000000" VerticalAlignment="Center">
          <TextBlock Text="{Binding ProfileText}" />
        </Border>
      </Grid>

      <!-- Bottom block -->
      <StackPanel Grid.Row="2" Spacing="0" MaxWidth="1400">
        <!-- Game caption -->
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,18" IsVisible="{Binding #Slides.CurrentName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Classes="label" Text="FROM YOUR LIBRARY" Foreground="#B3FFFFFF" VerticalAlignment="Center" />
          <TextBlock Text="·" Foreground="#80FFFFFF" VerticalAlignment="Center" />
          <TextBlock Text="{Binding #Slides.CurrentName}" FontSize="14" Foreground="#E6FFFFFF" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Text="{Binding TargetLabel}" FontSize="18" Foreground="#CCFFFFFF" />
        <TextBlock Text="{Binding ConsoleName}" FontSize="52" FontWeight="Bold" LetterSpacing="-1" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0" IsVisible="{Binding !StartFailed}">
          <Ellipse Classes="dot good pulse" VerticalAlignment="Center" />
          <TextBlock Text="{Binding LoaderText}" FontSize="16" Foreground="#E6FFFFFF" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Progress: one bar that fills through waking, connecting and starting the stream -->
        <StackPanel Margin="0,30,0,0" Spacing="12" IsVisible="{Binding !StartFailed}">
          <ProgressBar Classes="loader" Minimum="0" Maximum="1" Value="{Binding Progress}" />
          <Grid ColumnDefinitions="*,*,*">
            <TextBlock Classes="phase on" Text="{Binding FirstPhaseLabel}" />
            <TextBlock Grid.Column="1" Classes="phase" Classes.on="{Binding PhaseConnect}" Text="Connect" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="2" Classes="phase" Classes.on="{Binding PhaseStream}" Text="Stream" HorizontalAlignment="Right" />
          </Grid>
        </StackPanel>

        <!-- Play together: can't reach the friend directly, so they need our reply code -->
        <Border IsVisible="{Binding HasReplyCode}" Background="#33F5B841" BorderBrush="#80F5B841" BorderThickness="1"
                CornerRadius="12" Padding="18,14" Margin="0,22,0,0" HorizontalAlignment="Left" MaxWidth="900">
          <StackPanel Spacing="8">
            <TextBlock Text="Can't reach your friend directly. Send them this reply code" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="On their stream they open the menu, choose Play together, then Paste reply code. It's already copied for you, and Vexel keeps trying meanwhile."
                       FontSize="14" Foreground="#E6FFFFFF" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ReplyCode}" FontFamily="Menlo, Consolas, monospace" FontSize="15" TextWrapping="Wrap" />
            <Button Classes="ghost" Background="#40000000" Content="Copy reply code" Command="{Binding CopyReplyCodeCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>

        <!-- No controller: say so before the game starts -->
        <Border IsVisible="{Binding NoController}" Background="#33F5B841" BorderBrush="#80F5B841" BorderThickness="1"
                CornerRadius="10" Padding="14,10" Margin="0,22,0,0" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon Data="{StaticResource Icon.Gamepad}" Width="16" Height="16" Foreground="{StaticResource Warn}" />
            <TextBlock Text="No controller connected. Connect one before the game starts." FontSize="14" Foreground="#F2FFFFFF" VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- This device's or the console's connection: worth fixing (checked as the stream starts) -->
        <Border IsVisible="{Binding HasLinkWarnings}" Background="#33F5B841" BorderBrush="#80F5B841" BorderThickness="1"
                CornerRadius="10" Padding="14,10" Margin="0,14,0,0" HorizontalAlignment="Left" MaxWidth="900">
          <ItemsControl ItemsSource="{Binding LinkWarnings}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <PathIcon Data="{StaticResource Icon.Wifi}" Width="15" Height="15" Foreground="{StaticResource Warn}" />
                  <TextBlock Text="{Binding}" FontSize="14" Foreground="#F2FFFFFF" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <!-- Tip + cancel -->
        <!-- The start failed: say why, right here (whatever page Stream was pressed on) -->
        <StackPanel IsVisible="{Binding StartFailed}" Margin="0,22,0,0" Spacing="22">
          <Border Background="#40E5484D" BorderBrush="#99E5484D" BorderThickness="1" CornerRadius="12" Padding="18,14" HorizontalAlignment="Left" MaxWidth="900">
            <Grid ColumnDefinitions="Auto,*">
              <PathIcon Data="{StaticResource Icon.Alert}" Width="18" Height="18" Foreground="{StaticResource Bad}" VerticalAlignment="Top" Margin="0,2,12,0" />
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Couldn't start the stream" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Error}" FontSize="14" Foreground="#E6FFFFFF" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Classes="primary" Command="{Binding StreamAgainCommand}" Padding="18,11">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Refresh}" Width="14" Height="14" />
                <TextBlock Text="Try again" />
              </StackPanel>
            </Button>
            <Button Classes="ghost" Command="{Binding ExportDiagnosticsNowCommand}" Background="#40000000" Padding="18,11" Content="Save diagnostics" />
            <Button Classes="ghost" Command="{Binding DismissCommand}" Background="#40000000" Padding="18,11">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Close}" Width="14" Height="14" />
                <TextBlock Text="Close  (B)" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>

        <Grid ColumnDefinitions="*,Auto" Margin="0,30,0,0" IsVisible="{Binding !StartFailed}">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <PathIcon Data="{StaticResource Icon.Gamepad}" Width="16" Height="16" Foreground="#99FFFFFF" />
            <c:HintText Hint="{Binding Tip}" FontSize="14" Foreground="#B3FFFFFF" TextWrapping="Wrap" VerticalAlignment="Center" />
          </StackPanel>
          <Button Grid.Column="1" Classes="ghost" Command="{Binding StopCommand}" IsEnabled="{Binding !IsStopping}"
                  Background="#40000000" Padding="18,11" Margin="24,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource Icon.Close}" Width="14" Height="14" />
              <TextBlock Text="Cancel  (B)" IsVisible="{Binding !IsStopping}" />
              <TextBlock Text="Cancelling…" IsVisible="{Binding IsStopping}" />
            </StackPanel>
          </Button>
        </Grid>
      </StackPanel>
    </Grid>
  </Panel>
</UserControl>
