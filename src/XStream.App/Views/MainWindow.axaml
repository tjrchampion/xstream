<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XStream.App.ViewModels"
        xmlns:v="using:XStream.App.Views"
        xmlns:app="using:XStream.App"
        x:Class="XStream.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Vexel"
        Icon="avares://XStream/Assets/xstream.png"
        Width="1180" Height="760" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:ConsolesViewModel"><v:ConsolesView /></DataTemplate>
    <DataTemplate DataType="vm:CloudViewModel"><v:CloudView /></DataTemplate>
    <DataTemplate DataType="vm:SessionsViewModel"><v:SessionsView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><v:SettingsView /></DataTemplate>
  </Window.DataTemplates>

  <Panel>
    <!-- Signed in: sidebar + page -->
    <Grid ColumnDefinitions="236,*" IsVisible="{Binding IsSignedIn}" IsEnabled="{Binding !Stream.ShowLoader}">
      <Border Classes="sidebar" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
        <DockPanel Margin="16,22,16,16">
          <!-- Brand -->
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="11" Margin="6,0,0,26">
            <Image Source="avares://XStream/Assets/xstream.png" Width="34" Height="34" RenderOptions.BitmapInterpolationMode="HighQuality" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Vexel" FontSize="17" FontWeight="Bold" />
              <TextBlock Text="Remote play" Classes="caption" Margin="0,-1,0,0" />
            </StackPanel>
          </StackPanel>

          <!-- Exit -->
          <Button DockPanel.Dock="Bottom" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Margin="0,10,0,0" Padding="12,10" Command="{Binding ExitCommand}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="{StaticResource Icon.Power}" Width="16" Height="16" Foreground="{StaticResource Bad}" />
              <TextBlock Text="Exit Vexel" FontSize="14" />
            </StackPanel>
          </Button>

          <!-- Account -->
          <Border DockPanel.Dock="Bottom" Classes="tile" Padding="10">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource Surface3}">
                <PathIcon Data="{StaticResource Icon.Account}" Width="15" Height="15" Foreground="{StaticResource Muted}" />
              </Border>
              <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                <TextBlock Text="Signed in" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="Xbox account" Classes="caption" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Button Grid.Column="2" Classes="icon" Command="{Binding SignOutCommand}" ToolTip.Tip="Sign out">
                <PathIcon Data="{StaticResource Icon.Logout}" Foreground="{StaticResource Muted}" />
              </Button>
            </Grid>
          </Border>

          <!-- Controller hint -->
          <StackPanel DockPanel.Dock="Bottom" Margin="6,0,0,14" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource Icon.Gamepad}" Width="14" Height="14" Foreground="{StaticResource Faint}" />
              <TextBlock Text="CONTROLLER" Classes="label" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="7" IsVisible="{Binding ControllerKnown}" Margin="0,2,0,2">
              <Ellipse Classes="dot" Classes.on="{Binding HasController}" Classes.sleep="{Binding !HasController}" VerticalAlignment="Center" />
              <TextBlock FontSize="12.5" Text="{Binding ControllerText}" />
            </StackPanel>
            <TextBlock Classes="caption faint" TextWrapping="Wrap" Text="LB / RB switch page · A select · B back · Menu streams your console · Exit is below" />
          </StackPanel>

          <!-- Live stream pill -->
          <Button DockPanel.Dock="Bottom" Margin="0,0,0,14" Padding="12,10" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch" Background="{StaticResource AccentSoft}"
                  IsVisible="{Binding Stream.IsRunning}" Click="OnStreamPillClick">
            <Grid ColumnDefinitions="Auto,*">
              <Ellipse Classes="dot good pulse" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock Text="{Binding Stream.ConsoleName}" FontSize="13" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="caption" Foreground="{StaticResource Accent}" IsVisible="{Binding Stream.IsStreaming}">
                  <Run Text="Live · " /><Run Text="{Binding Stream.Elapsed}" />
                </TextBlock>
                <TextBlock Classes="caption" Foreground="{StaticResource Accent}" Text="Connecting…" IsVisible="{Binding !Stream.IsStreaming}" />
              </StackPanel>
            </Grid>
          </Button>

          <ListBox Classes="nav" ItemsSource="{Binding Nav}" SelectedItem="{Binding SelectedNav}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NavItem">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <PathIcon Data="{Binding Icon, Converter={x:Static app:Conv.Icon}}" Width="17" Height="17" />
                  <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <DockPanel Grid.Column="1">
      <!-- Update downloaded and verified -->
      <Border DockPanel.Dock="Top" Background="{StaticResource AccentSoft}" Padding="36,12" IsVisible="{Binding HasUpdate}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <PathIcon Data="{StaticResource Icon.Refresh}" Width="16" Height="16" Foreground="{StaticResource Accent}" Margin="0,0,12,0" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock FontWeight="SemiBold" Text="{Binding UpdateText}" />
            <TextBlock Classes="caption" Text="Restart Vexel to start using it. Takes a few seconds." />
          </StackPanel>
          <Button Grid.Column="2" Classes="ghost" Content="Later" Command="{Binding DismissUpdateCommand}" Margin="0,0,10,0" />
          <Button Grid.Column="3" Classes="primary" Content="Restart now" Command="{Binding RestartToUpdateCommand}" IsEnabled="{Binding !Stream.IsRunning}" />
        </Grid>
      </Border>
      <!-- Settings opened from the stream menu: the way back -->
      <Border DockPanel.Dock="Top" Background="{StaticResource AccentSoft}" Padding="36,14" IsVisible="{Binding Stream.IsAway}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Ellipse Classes="dot good pulse" VerticalAlignment="Center" Margin="0,0,12,0" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock FontWeight="SemiBold"><Run Text="Streaming " /><Run Text="{Binding Stream.ConsoleName}" /></TextBlock>
            <TextBlock Classes="caption" Text="Your controller works Vexel until you go back. Changes apply to the stream straight away." />
          </StackPanel>
          <Button Grid.Column="2" Classes="primary" Command="{Binding Stream.ReturnToGameCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource Icon.Play}" />
              <TextBlock Text="Back to game  (B)" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
      <TransitioningContentControl Content="{Binding CurrentPage}">
        <TransitioningContentControl.PageTransition>
          <CrossFade Duration="0:0:0.15" />
        </TransitioningContentControl.PageTransition>
      </TransitioningContentControl>
      </DockPanel>
    </Grid>

    <!-- Not signed in -->
    <Panel IsVisible="{Binding !IsSignedIn}">
      <v:SignInView DataContext="{Binding SignIn}" />
    </Panel>

    <!-- Starting a stream: full-screen connecting screen over everything -->
    <v:ConnectingView DataContext="{Binding Stream}" IsVisible="{Binding ShowLoader}" />
  </Panel>
</Window>
