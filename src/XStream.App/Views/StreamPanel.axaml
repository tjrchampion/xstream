<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XStream.App.ViewModels"
             xmlns:c="using:XStream.App.Controls"
             xmlns:app="using:XStream.App"
             x:Class="XStream.App.Views.StreamPanel"
             x:DataType="vm:StreamViewModel">
  <UserControl.Styles>
    <Style Selector="Border.step">
      <Setter Property="Width" Value="28" /><Setter Property="Height" Value="28" /><Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderThickness" Value="2" /><Setter Property="BorderBrush" Value="{StaticResource Surface3}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.step.done"><Setter Property="Background" Value="{StaticResource Accent}" /><Setter Property="BorderBrush" Value="{StaticResource Accent}" /></Style>
    <Style Selector="Border.step.active"><Setter Property="BorderBrush" Value="{StaticResource Accent}" /></Style>
    <Style Selector="Border.step.failed"><Setter Property="Background" Value="{StaticResource Bad}" /><Setter Property="BorderBrush" Value="{StaticResource Bad}" /></Style>
    <Style Selector="TextBlock.stepText"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{StaticResource Faint}" /></Style>
    <Style Selector="TextBlock.stepText.on"><Setter Property="Foreground" Value="{StaticResource Text}" /></Style>
    <Style Selector="TextBlock.unit"><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="{StaticResource Muted}" /><Setter Property="VerticalAlignment" Value="Bottom" /><Setter Property="Margin" Value="4,0,0,4" /></Style>
    <Style Selector="Border.verdict.good"><Setter Property="Background" Value="{StaticResource AccentSoft}" /></Style>
    <Style Selector="Border.verdict.warn"><Setter Property="Background" Value="{StaticResource WarnSoft}" /></Style>
    <Style Selector="Border.verdict.bad"><Setter Property="Background" Value="{StaticResource BadSoft}" /></Style>
    <Style Selector="Border.card.live"><Setter Property="BorderBrush" Value="#663DDC97" /></Style>
  </UserControl.Styles>

  <Border Classes="card" Padding="24" Classes.live="{Binding IsRunning}">
    <StackPanel Spacing="20">
      <!-- Header -->
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Width="48" Height="48" CornerRadius="13" Background="{StaticResource AccentSoft}">
          <PathIcon Data="{StaticResource Icon.Console}" Width="22" Height="22" Foreground="{StaticResource Accent}" />
        </Border>
        <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="3">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Classes="dot good pulse" IsVisible="{Binding IsStreaming}" Classes.warn="{Binding IsReconnecting}" />
            <TextBlock Classes="label" Foreground="{StaticResource Accent}" Text="STREAMING" IsVisible="{Binding IsStreaming}" />
            <TextBlock Classes="label" Text="CONNECTING" IsVisible="{Binding IsConnecting}" Foreground="{StaticResource Muted}" />
            <TextBlock Classes="label" Text="SESSION ENDED" IsVisible="{Binding !IsRunning}" />
            <Border Classes="chip"><TextBlock Text="{Binding ProfileText}" /></Border>
          </StackPanel>
          <TextBlock Classes="h2" FontSize="22" Text="{Binding ConsoleName}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <StackPanel VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="{Binding IsStreaming}">
            <TextBlock Classes="label" Text="TIME" HorizontalAlignment="Right" />
            <TextBlock Classes="mono" FontSize="18" FontWeight="SemiBold" Text="{Binding Elapsed}" HorizontalAlignment="Right" />
          </StackPanel>
          <Button Classes="danger" Command="{Binding StopCommand}" IsVisible="{Binding IsRunning}" IsEnabled="{Binding !IsStopping}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource Icon.Stop}" />
              <TextBlock Text="Stop" IsVisible="{Binding !IsStopping}" />
              <TextBlock Text="Stopping…" IsVisible="{Binding IsStopping}" />
            </StackPanel>
          </Button>
          <Button Classes="ghost" Command="{Binding DismissCommand}" IsVisible="{Binding !IsRunning}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource Icon.Close}" />
              <TextBlock Text="Close" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Progress steps (until the picture is up) -->
      <StackPanel Spacing="14" IsVisible="{Binding !IsStreaming}">
        <ItemsControl ItemsSource="{Binding Steps}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StepViewModel">
              <StackPanel Spacing="8" HorizontalAlignment="Center">
                <Border Classes="step" Classes.done="{Binding IsDone}" Classes.active="{Binding IsActive}" Classes.failed="{Binding IsFailed}"
                        HorizontalAlignment="Center">
                  <Panel>
                    <PathIcon Data="{StaticResource Icon.Check}" Width="13" Height="13" Foreground="{StaticResource OnAccent}" IsVisible="{Binding IsDone}" />
                    <PathIcon Data="{StaticResource Icon.Close}" Width="12" Height="12" Foreground="{StaticResource OnAccent}" IsVisible="{Binding IsFailed}" />
                    <Ellipse Classes="dot good pulse" IsVisible="{Binding IsActive}" />
                  </Panel>
                </Border>
                <TextBlock Classes="stepText" Classes.on="{Binding !IsPending}" Text="{Binding Title}" HorizontalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" IsVisible="{Binding IsRunning}">
          <ProgressBar IsIndeterminate="True" Width="120" VerticalAlignment="Center" />
          <c:HintText Classes="muted" Hint="{Binding StageText}" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>

      <!-- Error -->
      <Border Classes="banner bad" IsVisible="{Binding HasError}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <PathIcon Data="{StaticResource Icon.Alert}" Foreground="{StaticResource Bad}" Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,10,0" />
          <TextBlock Grid.Column="1" Text="{Binding Error}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="primary" Margin="14,0,0,0" VerticalAlignment="Center"
                  Command="{Binding StreamAgainCommand}" IsVisible="{Binding !IsRunning}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource Icon.Refresh}" />
              <TextBlock Text="Stream again" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <!-- Live numbers -->
      <StackPanel Spacing="12" IsVisible="{Binding IsStreaming}">
        <UniformGrid Columns="4" ColumnSpacing="12">
          <Border Classes="tile">
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="BITRATE" />
              <StackPanel Orientation="Horizontal">
                <TextBlock Classes="big" Text="{Binding Live.Mbps, StringFormat={}{0:F1}, FallbackValue=–}" />
                <TextBlock Classes="unit" Text="Mbps" />
              </StackPanel>
              <TextBlock Classes="caption" Text="{Binding Live.CapMbps, StringFormat=cap {0:F1} Mbps, FallbackValue=''}" />
              <c:Sparkline Values="{Binding BitrateHistory}" Stroke="{StaticResource Accent}" MinRange="5" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
          <Border Classes="tile">
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="PING" />
              <StackPanel Orientation="Horizontal">
                <TextBlock Classes="big" Text="{Binding Live.PingMs, StringFormat={}{0:F0}, FallbackValue=–}" />
                <TextBlock Classes="unit" Text="ms" />
              </StackPanel>
              <TextBlock Classes="caption" Text="{Binding Live.JitterMs, StringFormat=jitter {0:F1} ms, FallbackValue=''}" />
              <c:Sparkline Values="{Binding PingHistory}" Stroke="{StaticResource Info}" MinRange="20" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
          <Border Classes="tile">
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="NETWORK → SCREEN" />
              <StackPanel Orientation="Horizontal">
                <TextBlock Classes="big" Text="{Binding Live.NetToScreenP50Ms, StringFormat={}{0:F1}, FallbackValue=–}" />
                <TextBlock Classes="unit" Text="ms" />
              </StackPanel>
              <TextBlock Classes="caption" Text="{Binding Live.NetToScreenP99Ms, StringFormat=worst 1% {0:F1} ms, FallbackValue=''}" />
              <c:Sparkline Values="{Binding LatencyHistory}" Stroke="{StaticResource Violet}" MinRange="10" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
          <Border Classes="tile">
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="FRAME RATE" />
              <StackPanel Orientation="Horizontal">
                <TextBlock Classes="big" Text="{Binding Live.Fps, StringFormat={}{0:F0}, FallbackValue=–}" />
                <TextBlock Classes="unit" Text="fps" />
              </StackPanel>
              <TextBlock Classes="caption" Text="{Binding Live.DecodeMs, StringFormat=decode {0:F1} ms, FallbackValue=''}" />
            </StackPanel>
          </Border>
        </UniformGrid>

        <UniformGrid Columns="4" ColumnSpacing="12">
          <Border Classes="tile" Padding="14,10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="caption" Text="Packet loss" />
              <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Live.LossPct, StringFormat={}{0:F1}%, FallbackValue=–}" />
            </Grid>
          </Border>
          <Border Classes="tile" Padding="14,10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="caption" Text="Buffer" />
              <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Live.BufferMs, StringFormat={}{0:F0} ms, FallbackValue=–}" />
            </Grid>
          </Border>
          <Border Classes="tile" Padding="14,10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="caption" Text="Controller" />
              <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Live.PadHz, StringFormat={}{0:F0} Hz, FallbackValue=–}" />
            </Grid>
          </Border>
          <Border Classes="tile" Padding="14,10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="caption" Text="Link" />
              <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Live.Link, FallbackValue=–}" />
            </Grid>
          </Border>
        </UniformGrid>

        <Border Classes="banner verdict" Classes.good="{Binding VerdictKind, Converter={x:Static app:Conv.Is}, ConverterParameter=good}"
                Classes.warn="{Binding VerdictKind, Converter={x:Static app:Conv.Is}, ConverterParameter=warn}"
                Classes.bad="{Binding VerdictKind, Converter={x:Static app:Conv.Is}, ConverterParameter=bad}"
                IsVisible="{Binding Verdict, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <Grid ColumnDefinitions="Auto,*">
            <PathIcon Data="{StaticResource Icon.Bolt}" Width="15" Height="15" Margin="0,1,10,0" VerticalAlignment="Top" />
            <TextBlock Grid.Column="1" Text="{Binding Verdict}" TextWrapping="Wrap" />
          </Grid>
        </Border>
      </StackPanel>

      <!-- After the session -->
      <StackPanel Spacing="12" IsVisible="{Binding Summary, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Classes="label" Text="HOW IT WENT" />
        <UniformGrid Columns="5" ColumnSpacing="12">
          <Border Classes="tile">
            <StackPanel><TextBlock Classes="caption" Text="Played" />
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Summary.Minutes, StringFormat={}{0:F1} min, FallbackValue=–}" /></StackPanel>
          </Border>
          <Border Classes="tile">
            <StackPanel><TextBlock Classes="caption" Text="Freezes" />
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Summary.Freezes, FallbackValue=–}" /></StackPanel>
          </Border>
          <Border Classes="tile">
            <StackPanel><TextBlock Classes="caption" Text="Avg bitrate" />
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Summary.AvgMbps, StringFormat={}{0:F1} Mbps, FallbackValue=–}" /></StackPanel>
          </Border>
          <Border Classes="tile">
            <StackPanel><TextBlock Classes="caption" Text="Median ping" />
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Summary.MedianRttMs, StringFormat={}{0:F0} ms, FallbackValue=–}" /></StackPanel>
          </Border>
          <Border Classes="tile">
            <StackPanel><TextBlock Classes="caption" Text="Packet loss" />
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Summary.AvgLossPct, StringFormat={}{0:F2}%, FallbackValue=–}" /></StackPanel>
          </Border>
        </UniformGrid>
      </StackPanel>

      <!-- Details -->
      <Expander Header="Connection details and log" HorizontalAlignment="Stretch">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" IsVisible="{Binding Info, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid.Styles>
              <Style Selector="TextBlock"><Setter Property="Margin" Value="0,3" /><Setter Property="FontSize" Value="13" /></Style>
              <Style Selector="TextBlock.k"><Setter Property="Foreground" Value="{StaticResource Muted}" /><Setter Property="Margin" Value="0,3,24,3" /></Style>
            </Grid.Styles>
            <TextBlock Classes="k" Text="Video decode" />
            <TextBlock Grid.Column="1" Text="{Binding Info.Decoder, FallbackValue=–}" />
            <TextBlock Grid.Row="1" Classes="k" Text="Renderer" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Info.Renderer, FallbackValue=–}" />
            <TextBlock Grid.Row="2" Classes="k" Text="Controller" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Info.Controller, FallbackValue=–}" />
            <TextBlock Grid.Row="3" Classes="k" Text="Low-latency input" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Info.LowLatencyInput, FallbackValue=–}" />
            <TextBlock Grid.Row="5" Classes="k" Text="Game audio" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Info.Audio, FallbackValue=–}" />
            <TextBlock Grid.Row="4" Classes="k" Text="Bitrate caps / resend" />
            <TextBlock Grid.Row="4" Grid.Column="1">
              <Run Text="REMB " /><Run Text="{Binding Info.Remb, FallbackValue=–}" /><Run Text="  ·  NACK " /><Run Text="{Binding Info.Nack, FallbackValue=–}" />
            </TextBlock>
          </Grid>
          <Border Background="{StaticResource Bg}" CornerRadius="10" Padding="12" MaxHeight="220">
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding LogLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <SelectableTextBlock Text="{Binding}" Classes="mono" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="ghost" Command="{Binding OpenLogCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Folder}" />
                <TextBlock Text="Open session logs" />
              </StackPanel>
            </Button>
            <Button Classes="ghost" Command="{Binding ExportDiagnosticsNowCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Bug}" />
                <TextBlock Text="Export diagnostics" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Expander>
    </StackPanel>
  </Border>
</UserControl>
