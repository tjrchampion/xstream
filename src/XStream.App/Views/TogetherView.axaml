<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XStream.App.ViewModels"
             x:Class="XStream.App.Views.TogetherView"
             x:DataType="vm:TogetherViewModel">
  <UserControl.Styles>
    <Style Selector="Border.step">
      <Setter Property="Width" Value="28" /><Setter Property="Height" Value="28" /><Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{StaticResource AccentSoft}" /><Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Border.step > TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Accent}" /><Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.code"><Setter Property="FontFamily" Value="Menlo, Consolas, monospace" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="TextBlock.problem"><Setter Property="Foreground" Value="{StaticResource Warn}" /></Style>
    <Style Selector="TextBlock.caption.warn"><Setter Property="Foreground" Value="{StaticResource Warn}" /></Style>
  </UserControl.Styles>
  <ScrollViewer>
    <StackPanel Margin="36,32,36,36" Spacing="22" MaxWidth="1100">
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="Play together" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Play with a friend at another house. They see your game and hear it, and their controller joins your console as the next player. No server and no extra account: Vexel connects the two of you directly." />
      </StackPanel>

      <!-- Your stream: share the running stream and manage who's in, as the stream menu's panel does -->
      <Border Classes="card" Padding="24,22" IsVisible="{Binding ShowShareCard}">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <PathIcon Data="{StaticResource Icon.Together}" Width="20" Height="20" Foreground="{StaticResource Accent}" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" Classes="h2" Text="Your stream" VerticalAlignment="Center" />
            <Border Grid.Column="2" Classes="chip accent" IsVisible="{Binding Stream.IsSharing}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Ellipse Classes="dot good pulse" VerticalAlignment="Center" />
                <TextBlock Text="SHARING" />
              </StackPanel>
            </Border>
          </Grid>

          <!-- Nothing running -->
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding NoStream}">
            <TextBlock Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="Start a stream from Consoles, then share it here or from the stream menu." />
            <Button Grid.Column="1" Classes="primary" Command="{Binding GoToConsolesCommand}" Margin="16,0,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Console}" />
                <TextBlock Text="Go to Consoles" />
              </StackPanel>
            </Button>
          </Grid>

          <!-- Running but not ready to share yet -->
          <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding Stream.ShareNotReady}"
                     Text="Your stream is starting. You can share it once the picture is up." />

          <!-- Ready, not sharing -->
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Stream.CanShare}">
            <StackPanel Spacing="4" IsVisible="{Binding !Stream.IsSharing}">
              <TextBlock FontWeight="SemiBold"><Run Text="Streaming " /><Run Text="{Binding Stream.ConsoleName}" /></TextBlock>
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="Share it and Vexel makes an invite for you to send a friend. Their controller joins your console as the next player." />
            </StackPanel>
            <Button Grid.Column="1" Classes="primary" Command="{Binding Stream.ShareTogetherCommand}" IsEnabled="{Binding !Stream.SharePending}"
                    IsVisible="{Binding !Stream.IsSharing}" Margin="16,0,0,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Together}" />
                <TextBlock Text="Share this stream" IsVisible="{Binding !Stream.SharePending}" />
                <TextBlock Text="Starting…" IsVisible="{Binding Stream.SharePending}" />
              </StackPanel>
            </Button>
          </Grid>

          <!-- Sharing -->
          <StackPanel Spacing="18" IsVisible="{Binding Stream.IsSharing}">
            <TextBlock FontWeight="SemiBold"><Run Text="{Binding SharingText}" /><Run Text=" on " /><Run Text="{Binding Stream.ConsoleName}" /></TextBlock>
            <Grid ColumnDefinitions="*,22,*">
              <StackPanel Spacing="16">
                <!-- Invite -->
                <StackPanel Spacing="8">
                  <TextBlock Classes="label" Text="INVITE" />
                  <Border Classes="tile" Padding="14,12">
                    <Panel>
                      <TextBlock Classes="code" FontSize="12.5" Text="{Binding SharingInvite}" IsVisible="{Binding HasInvite}" />
                      <TextBlock Classes="muted" FontSize="13" Text="Getting the invite ready…" IsVisible="{Binding !HasInvite}" />
                    </Panel>
                  </Border>
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Classes="primary" Command="{Binding CopyInviteCommand}" IsEnabled="{Binding HasInvite}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource Icon.Copy}" />
                        <TextBlock Text="Copy invite" />
                      </StackPanel>
                    </Button>
                    <TextBlock Classes="caption" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Text="{Binding CopiedText}" />
                  </StackPanel>
                </StackPanel>
                <!-- Reply code -->
                <StackPanel Spacing="8">
                  <TextBlock Classes="label" Text="REPLY CODE" />
                  <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap"
                             Text="If your friend's Vexel shows a reply code (it starts VXR1-), they send it to you. Paste it here." />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Text="{Binding ReplyText}" Watermark="Paste your friend's reply code" AcceptsReturn="False"
                             FontFamily="Menlo, Consolas, monospace" FontSize="12.5" />
                    <Button Grid.Column="1" Classes="ghost" Content="Accept" Command="{Binding AcceptReplyCommand}" Margin="8,0,0,0" />
                  </Grid>
                  <Button Classes="ghost" HorizontalAlignment="Left" Command="{Binding PasteReplyCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <PathIcon Data="{StaticResource Icon.Copy}" />
                      <TextBlock Text="Paste reply code" />
                    </StackPanel>
                  </Button>
                  <TextBlock Foreground="{StaticResource Bad}" TextWrapping="Wrap" FontSize="13" Text="{Binding ReplyError}" IsVisible="{Binding HasReplyError}" />
                  <TextBlock TextWrapping="Wrap" FontSize="13" Text="{Binding ShareNote}" IsVisible="{Binding HasShareNote}"
                             Foreground="{StaticResource Accent}" Classes.problem="{Binding ShareNoteIsProblem}" />
                </StackPanel>
              </StackPanel>

              <!-- Players -->
              <StackPanel Grid.Column="2" Spacing="8">
                <TextBlock Classes="label" Text="PLAYERS" />
                <ItemsControl ItemsSource="{Binding Players}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TogetherPlayerRow">
                      <Border Classes="tile" Padding="14,10" MinHeight="52">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <Border Classes="chip" Classes.accent="{Binding IsHost}" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Label}" />
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="caption" Text="{Binding Detail}" IsVisible="{Binding !IsHost}"
                                       Classes.warn="{Binding Poor}" />
                          </StackPanel>
                          <Button Grid.Column="2" Classes="ghost" Content="Remove" IsVisible="{Binding CanRemove}"
                                  Command="{Binding $parent[ItemsControl].((vm:TogetherViewModel)DataContext).Stream.RemoveGuestCommand, FallbackValue={x:Null}}"
                                  CommandParameter="{Binding Slot}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap" Text="Up to three friends can join. Each one gets the next controller slot." />
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap" Text="While you play together the picture is capped at about 15 Mbps." />
                <TextBlock Classes="caption" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Text="{Binding CapText}"
                           IsVisible="{Binding CapText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
              <Button Grid.Column="1" Classes="danger" Command="{Binding Stream.StopSharingCommand}" Margin="16,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource Icon.Stop}" />
                  <TextBlock Text="Stop sharing" />
                </StackPanel>
              </Button>
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Watching a friend's stream -->
      <Border Classes="banner good" Padding="18,14" IsVisible="{Binding ShowGuestCard}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Ellipse Classes="dot good pulse" VerticalAlignment="Center" Margin="0,0,12,0" />
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock FontWeight="SemiBold" Text="{Binding Stream.GuestText}" />
            <TextBlock Classes="caption" Text="Your controller plays on your friend's console. Leave ends it here." />
          </StackPanel>
          <Button Grid.Column="2" Classes="danger" Command="{Binding Stream.StopCommand}" IsEnabled="{Binding !Stream.IsStopping}" Margin="12,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource Icon.Close}" />
              <TextBlock Text="Leave" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <Grid ColumnDefinitions="*,22,*">
        <!-- Invite a friend -->
        <Border Classes="card" Padding="24,22">
          <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Data="{StaticResource Icon.Together}" Width="20" Height="20" Foreground="{StaticResource Accent}" />
              <TextBlock Classes="h2" Text="Invite a friend" />
            </StackPanel>
            <Grid ColumnDefinitions="Auto,*">
              <Border Classes="step"><TextBlock Text="1" /></Border>
              <TextBlock Grid.Column="1" Margin="12,4,0,0" TextWrapping="Wrap" Text="Start a stream from Consoles, as usual." />
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
              <Border Classes="step"><TextBlock Text="2" /></Border>
              <TextBlock Grid.Column="1" Margin="12,4,0,0" TextWrapping="Wrap" Text="Share it with Your stream above, or open the stream menu (hold View + Menu, or press Esc) and choose Play together." />
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
              <Border Classes="step"><TextBlock Text="3" /></Border>
              <TextBlock Grid.Column="1" Margin="12,4,0,0" TextWrapping="Wrap" Text="The invite is copied for you. Send it to your friend in a message. When they join, their controller is Player 2." />
            </Grid>
            <Border Classes="tile" Padding="14,12">
              <StackPanel Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="What your friend needs" />
                <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13" Text="Vexel on their computer and a controller. Not Game Pass, not an Xbox, not even an Xbox account." />
                <TextBlock FontWeight="SemiBold" Text="Your upload carries their picture" Margin="0,6,0,0" />
                <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13" Text="While you play together the picture is capped at about 15 Mbps for both of you, and lower if your friend's connection is losing packets." />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Join a friend -->
        <Border Grid.Column="2" Classes="card" Padding="24,22">
          <StackPanel Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Data="{StaticResource Icon.Gamepad}" Width="20" Height="20" Foreground="{StaticResource Accent}" />
              <TextBlock Classes="h2" Text="Join a friend" />
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Classes="label" Text="THEIR INVITE" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding Invite}" Watermark="Paste the invite your friend sent (it starts VX1-)" TextWrapping="Wrap"
                         AcceptsReturn="False" MinHeight="64" FontFamily="Menlo, Consolas, monospace" FontSize="12.5" />
                <Button Grid.Column="1" Classes="ghost" Content="Paste" Command="{Binding PasteInviteCommand}" Margin="8,0,0,0" VerticalAlignment="Top" />
              </Grid>
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Classes="label" Text="YOUR NAME" />
              <TextBox Text="{Binding Name}" Watermark="The name your friend sees" MaxLength="24" />
            </StackPanel>
            <TextBlock Foreground="{StaticResource Bad}" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />
            <Button Classes="primary" HorizontalAlignment="Left" Command="{Binding JoinCommand}" IsEnabled="{Binding CanJoin}" Padding="20,11">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Play}" />
                <TextBlock Text="Join" />
              </StackPanel>
            </Button>
            <Border Classes="tile" Padding="14,12">
              <StackPanel Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="If it can't connect straight away" />
                <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13"
                           Text="Some routers need both sides to connect at the same time. After a few seconds Vexel shows a reply code (and copies it). Send it back to your friend: on their stream they choose Play together, then Paste reply code." />
              </StackPanel>
            </Border>
            <!-- Joining now and a reply code is needed -->
            <Border Classes="banner warn" Padding="14,12" IsVisible="{Binding Stream.HasReplyCode}">
              <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="Send your friend this reply code" />
                <TextBlock Classes="code" FontSize="13" Text="{Binding Stream.ReplyCode}" />
                <Button Classes="ghost" Content="Copy reply code" Command="{Binding Stream.CopyReplyCodeCommand}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
