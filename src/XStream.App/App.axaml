<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:XStream.App.Controls"
             x:Class="XStream.App.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <!-- Palette -->
      <Color x:Key="AccentColor">#3DDC97</Color>
      <SolidColorBrush x:Key="Bg" Color="#0C0E12" />
      <SolidColorBrush x:Key="Sidebar" Color="#111419" />
      <SolidColorBrush x:Key="Surface" Color="#161A20" />
      <SolidColorBrush x:Key="Surface2" Color="#1D222A" />
      <SolidColorBrush x:Key="Surface3" Color="#262C36" />
      <SolidColorBrush x:Key="Line" Color="#262B33" />
      <SolidColorBrush x:Key="Text" Color="#ECEEF1" />
      <SolidColorBrush x:Key="Muted" Color="#8E98A5" />
      <SolidColorBrush x:Key="Faint" Color="#5D6672" />
      <SolidColorBrush x:Key="Accent" Color="#3DDC97" />
      <SolidColorBrush x:Key="AccentHover" Color="#5BE6A8" />
      <SolidColorBrush x:Key="AccentPressed" Color="#2BBF80" />
      <SolidColorBrush x:Key="AccentSoft" Color="#1F3DDC97" />
      <SolidColorBrush x:Key="OnAccent" Color="#06130D" />
      <SolidColorBrush x:Key="Warn" Color="#F5B841" />
      <SolidColorBrush x:Key="WarnSoft" Color="#1FF5B841" />
      <SolidColorBrush x:Key="Bad" Color="#FF6B6B" />
      <SolidColorBrush x:Key="BadSoft" Color="#1FFF6B6B" />
      <SolidColorBrush x:Key="Info" Color="#6AB0FF" />
      <SolidColorBrush x:Key="Violet" Color="#B18CFF" />

      <!-- Fluent overrides so built-in controls (toggles, sliders, focus) pick up the accent -->
      <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#3DDC97" />
      <Color x:Key="SystemAccentColor">#3DDC97</Color>
      <Color x:Key="SystemAccentColorDark1">#2BBF80</Color>
      <Color x:Key="SystemAccentColorDark2">#22A06B</Color>
      <Color x:Key="SystemAccentColorLight1">#5BE6A8</Color>
      <Color x:Key="SystemAccentColorLight2">#7CEDBA</Color>
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#06130D" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#06130D" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#06130D" />
      <SolidColorBrush x:Key="FocusStrokeColorOuter" Color="#3DDC97" />
      <Thickness x:Key="SystemControlFocusVisualMargin">-3</Thickness>

      <!-- Icons (24x24 paths) -->
      <StreamGeometry x:Key="Icon.Console">F0 M7,2H17A2,2 0 0,1 19,4V20A2,2 0 0,1 17,22H7A2,2 0 0,1 5,20V4A2,2 0 0,1 7,2M12,4.6A1.4,1.4 0 0,0 10.6,6A1.4,1.4 0 0,0 12,7.4A1.4,1.4 0 0,0 13.4,6A1.4,1.4 0 0,0 12,4.6M8,10H16V11H8Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.History">M13.5,8H12V13L16.28,15.54L17,14.33L13.5,12.25V8M13,3A9,9 0 0,0 4,12H1L4.96,16.03L9,12H6A7,7 0 0,1 13,5A7,7 0 0,1 20,12A7,7 0 0,1 13,19C11.07,19 9.32,18.21 8.06,16.94L6.64,18.36C8.27,20 10.5,21 13,21A9,9 0 0,0 22,12A9,9 0 0,0 13,3</StreamGeometry>
      <StreamGeometry x:Key="Icon.Settings">M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Play">M8,5.14V19.14L19,12.14L8,5.14Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Stop">M8,6H16A2,2 0 0,1 18,8V16A2,2 0 0,1 16,18H8A2,2 0 0,1 6,16V8A2,2 0 0,1 8,6Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Refresh">M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Alert">M1,21H23L12,2L1,21M13,18H11V16H13V18M13,14H11V10H13V14Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Copy">M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.OpenLink">M14,3V5H17.59L7.76,14.83L9.17,16.24L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Check">M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Close">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Folder">M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Account">M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Logout">M16,17V14H9V10H16V7L21,12L16,17M14,2A2,2 0 0,1 16,4V6H14V4H5V20H14V18H16V20A2,2 0 0,1 14,22H5A2,2 0 0,1 3,20V4A2,2 0 0,1 5,2H14Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Wifi">M12,21L15.6,16.2C14.6,15.45 13.35,15 12,15C10.65,15 9.4,15.45 8.4,16.2L12,21M12,3C7.95,3 4.21,4.34 1.2,6.6L3,9C5.5,7.12 8.62,6 12,6C15.38,6 18.5,7.12 21,9L22.8,6.6C19.79,4.34 16.05,3 12,3M12,9C9.3,9 6.81,9.89 4.8,11.4L6.6,13.8C8.1,12.67 9.97,12 12,12C14.03,12 15.9,12.67 17.4,13.8L19.2,11.4C17.19,9.89 14.7,9 12,9Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Gamepad">M6,9H8V11H10V13H8V15H6V13H4V11H6V9M18.5,9A1.5,1.5 0 0,1 20,10.5A1.5,1.5 0 0,1 18.5,12A1.5,1.5 0 0,1 17,10.5A1.5,1.5 0 0,1 18.5,9M15.5,12A1.5,1.5 0 0,1 17,13.5A1.5,1.5 0 0,1 15.5,15A1.5,1.5 0 0,1 14,13.5A1.5,1.5 0 0,1 15.5,12M17,5A7,7 0 0,1 24,12A7,7 0 0,1 17,19C15.04,19 13.27,18.2 12,16.9C10.73,18.2 8.96,19 7,19A7,7 0 0,1 0,12A7,7 0 0,1 7,5H17M7,7A5,5 0 0,0 2,12A5,5 0 0,0 7,17C8.64,17 10.09,16.21 11,15H13C13.91,16.21 15.36,17 17,17A5,5 0 0,0 22,12A5,5 0 0,0 17,7H7Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Bolt">M11,15H6L13,1V9H18L11,23V15Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Power">M16.56,5.44L15.11,6.89C16.84,7.94 18,9.83 18,12A6,6 0 0,1 12,18A6,6 0 0,1 6,12C6,9.83 7.16,7.94 8.88,6.88L7.44,5.44C5.36,6.88 4,9.28 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12C20,9.28 18.64,6.88 16.56,5.44M13,3H11V13H13</StreamGeometry>
      <StreamGeometry x:Key="Icon.Bug">M14,12H10V10H14M14,16H10V14H14M20,8H17.19C16.74,7.22 16.12,6.55 15.37,6.04L17,4.41L15.59,3L13.42,5.17C12.96,5.06 12.5,5 12,5C11.5,5 11.04,5.06 10.59,5.17L8.41,3L7,4.41L8.62,6.04C7.88,6.55 7.26,7.22 6.81,8H4V10H6.09C6.04,10.33 6,10.66 6,11V12H4V14H6V15C6,15.34 6.04,15.67 6.09,16H4V18H6.81C7.85,19.79 9.78,21 12,21C14.22,21 16.15,19.79 17.19,18H20V16H17.91C17.96,15.67 18,15.34 18,15V14H20V12H18V11C18,10.66 17.96,10.33 17.91,10H20V8Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Cloud">M19.35,10.03C18.67,6.59 15.64,4 12,4C9.11,4 6.6,5.64 5.35,8.03C2.34,8.36 0,10.9 0,14A6,6 0 0,0 6,20H19A5,5 0 0,0 24,15C24,12.36 21.95,10.22 19.35,10.03Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Search">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Grid">M3,3H10V10H3V3M14,3H21V10H14V3M3,14H10V21H3V14M14,14H21V21H14V14Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.List">M3,4H7V8H3V4M9,5V7H21V5H9M3,10H7V14H3V10M9,11V13H21V11H9M3,16H7V20H3V16M9,17V19H21V17H9Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.ChevronLeft">M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z</StreamGeometry>
      <!-- Controller buttons: View (two overlapping windows) and Menu (three lines) -->
      <StreamGeometry x:Key="Icon.PadView">F0 M3,3H14V9H12V5H5V12H9V14H3Z M9,9H20V20H9Z M11,11V18H18V11Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.PadMenu">M4,6H20V8H4Z M4,11H20V13H4Z M4,16H20V18H4Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Chevron">M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z</StreamGeometry>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="{StaticResource Bg}" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <!-- Type -->
    <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="28" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="LetterSpacing" Value="-0.4" /></Style>
    <Style Selector="TextBlock.h2"><Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.h3"><Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{StaticResource Muted}" /></Style>
    <Style Selector="TextBlock.faint"><Setter Property="Foreground" Value="{StaticResource Faint}" /></Style>
    <Style Selector="TextBlock.caption"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{StaticResource Muted}" /></Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.8" /><Setter Property="Foreground" Value="{StaticResource Faint}" />
    </Style>
    <Style Selector="TextBlock.big"><Setter Property="FontSize" Value="26" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.mono"><Setter Property="FontFamily" Value="Menlo, Consolas, monospace" /></Style>

    <!-- Surfaces -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource Surface}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="22" />
    </Style>
    <Style Selector="Border.tile">
      <Setter Property="Background" Value="{StaticResource Surface2}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14,12" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{StaticResource Surface3}" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.chip > TextBlock"><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Border.chip.accent"><Setter Property="Background" Value="{StaticResource AccentSoft}" /></Style>
    <Style Selector="Border.chip.accent > TextBlock"><Setter Property="Foreground" Value="{StaticResource Accent}" /></Style>
    <Style Selector="Border.banner">
      <Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="14,12" />
      <Setter Property="Background" Value="{StaticResource Surface2}" />
    </Style>
    <Style Selector="Border.banner.good"><Setter Property="Background" Value="{StaticResource AccentSoft}" /></Style>
    <Style Selector="Border.banner.warn"><Setter Property="Background" Value="{StaticResource WarnSoft}" /></Style>
    <Style Selector="Border.banner.bad"><Setter Property="Background" Value="{StaticResource BadSoft}" /></Style>

    <!-- Status dots -->
    <Style Selector="Ellipse.dot"><Setter Property="Width" Value="8" /><Setter Property="Height" Value="8" /><Setter Property="Fill" Value="{StaticResource Faint}" /></Style>
    <Style Selector="Ellipse.dot.on, Ellipse.dot.good"><Setter Property="Fill" Value="{StaticResource Accent}" /></Style>
    <Style Selector="Ellipse.dot.sleep, Ellipse.dot.warn"><Setter Property="Fill" Value="{StaticResource Warn}" /></Style>
    <Style Selector="Ellipse.dot.bad"><Setter Property="Fill" Value="{StaticResource Bad}" /></Style>
    <Style Selector="Ellipse.pulse">
      <Style.Animations>
        <Animation Duration="0:0:1.6" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Buttons -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
      <Setter Property="Padding" Value="18,11" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentHover}" /><Setter Property="Foreground" Value="{StaticResource OnAccent}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentPressed}" /><Setter Property="Foreground" Value="{StaticResource OnAccent}" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Surface3}" /><Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Surface2}" /><Setter Property="BorderBrush" Value="{StaticResource Surface3}" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{StaticResource BadSoft}" />
      <Setter Property="Foreground" Value="{StaticResource Bad}" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#33FF6B6B" /><Setter Property="Foreground" Value="{StaticResource Bad}" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Padding" Value="9" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button PathIcon"><Setter Property="Width" Value="15" /><Setter Property="Height" Value="15" /></Style>

    <!-- Sidebar navigation -->
    <Style Selector="ListBox.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Surface2}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoft}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected">
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>

    <!-- Profile cards (radio buttons drawn as cards) -->
    <Style Selector="RadioButton.profile">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="card" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}"
                  BorderThickness="1.5" CornerRadius="14" Padding="16">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="RadioButton.profile:pointerover /template/ Border#card"><Setter Property="BorderBrush" Value="{StaticResource Surface3}" /></Style>
    <Style Selector="RadioButton.profile:checked /template/ Border#card">
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="Background" Value="#143DDC97" />
    </Style>

    <!-- Segmented choice (clarity levels) -->
    <Style Selector="RadioButton.seg /template/ Border#card"><Setter Property="Padding" Value="14,8" /><Setter Property="CornerRadius" Value="10" /></Style>

    <!-- Console cards -->
    <Style Selector="Border.console">
      <Setter Property="Transitions">
        <Transitions><BrushTransition Property="BorderBrush" Duration="0:0:0.15" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.console:pointerover"><Setter Property="BorderBrush" Value="{StaticResource Surface3}" /></Style>
    <Style Selector="Border.console.streaming"><Setter Property="BorderBrush" Value="{StaticResource Accent}" /></Style>

    <!-- Settings rows -->
    <Style Selector="Grid.row"><Setter Property="Margin" Value="0,10" /></Style>
    <Style Selector="Separator">
      <Setter Property="Background" Value="{StaticResource Line}" /><Setter Property="Margin" Value="0,4" /><Setter Property="Height" Value="1" />
    </Style>

    <!-- Expander: quiet header that matches the tiles -->
    <Style Selector="Expander">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{StaticResource Surface2}" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
      <Setter Property="Background" Value="{StaticResource Surface2}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border#ToggleButtonBackground">
      <Setter Property="Background" Value="{StaticResource Surface3}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Expander:expanded /template/ ToggleButton#ExpanderHeader">
      <Setter Property="CornerRadius" Value="12,12,0,0" />
    </Style>
    <Style Selector="Expander /template/ Border#ExpanderContent">
      <Setter Property="Background" Value="{StaticResource Surface2}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0,0,12,12" />
    </Style>

    <Style Selector="Grid.row > StackPanel"><Setter Property="Margin" Value="0,0,24,0" /></Style>

    <!-- Focus: a clear accent outline wherever the controller / keyboard is (replaces Fluent's thin adorner) -->
    <Style Selector="Button, ToggleButton, ToggleSwitch, Slider, ComboBox, ListBoxItem, RadioButton">
      <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>
    <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="BorderThickness" Value="2.5" />
    </Style>
    <Style Selector="Button.primary:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{StaticResource Text}" />
      <Setter Property="Background" Value="{StaticResource AccentHover}" />
    </Style>
    <Style Selector="RadioButton.profile:focus-visible /template/ Border#card">
      <Setter Property="BorderBrush" Value="{StaticResource Text}" />
      <Setter Property="BorderThickness" Value="2.5" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ComboBox:focus-visible /template/ Border#Background">
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="BorderThickness" Value="2.5" />
    </Style>
    <Style Selector="ToggleSwitch:focus-visible /template/ Border#OuterBorder">
      <Setter Property="BorderBrush" Value="{StaticResource Text}" />
      <Setter Property="BorderThickness" Value="2.5" />
    </Style>
    <Style Selector="Slider:focus-visible /template/ Thumb">
      <Setter Property="Width" Value="26" /><Setter Property="Height" Value="26" />
    </Style>
    <Style Selector="Slider:focus-visible">
      <Setter Property="Background" Value="{StaticResource Surface3}" />
    </Style>
    <Style Selector="Expander:focus-within /template/ ToggleButton#ExpanderHeader:focus-visible">
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="c|Sparkline"><Setter Property="Height" Value="34" /></Style>
  </Application.Styles>
</Application>
